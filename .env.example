# === WhatsApp AI Group Assistant Configuration ===

# Server
PORT=3000
NODE_ENV=development

# Database — PostgreSQL (Render.com sets this automatically)
# Leave empty to use in-memory fallback (for local testing without DB)
DATABASE_URL=

# LLM Provider — Google AI
LLM_PROVIDER=google
GOOGLE_API_KEY=your-google-ai-api-key
GOOGLE_MODEL=gemma-4-31b-it

# Tavily Search API
TAVILY_API_KEY=tvly-your-tavily-api-key

# Redis (optional — falls back to in-memory if not set)
REDIS_URL=

# Bot Settings
BOT_NICKNAME=AI Assistant
BOT_ACTIVITY_LEVEL=medium   # low | medium | high
BOT_TIMEZONE=Asia/Bishkek

# Admin credentials for web panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# QR Code session persistence
SESSION_DIR=./data/sessions
